# Copy to .env on the VM (create-vm.sh does this) and fill in the secrets.
# .env is not committed.

# Public address Caddy serves and gets a certificate for.
SITE_ADDRESS=chemforge.centralindia.cloudapp.azure.com

# Signs login tokens. create-vm.sh generates one.
SECRET_KEY=

# Reaction index (public Hugging Face dataset).
REACTIONS_REPO=S-Rohan-1904/chem-forge-reactions

# Backup of accounts and saved molecules to a private Hugging Face dataset.
# Leave HF_TOKEN empty until Render is switched off, so the two never write at once.
HF_DATASET_REPO=
HF_TOKEN=

# Usernames that may open the Stats tab, comma separated, and the code needed to register them.
ADMIN_USERS=
ADMIN_SIGNUP_CODE=

# Free key from https://openalex.org for the Literature card.
OPENALEX_API_KEY=
